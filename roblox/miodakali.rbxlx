			<Color3uint8 name="Color3uint8">4294962355</Color3uint8>
			<Vector3 name="size"><X>8</X><Y>0.8</Y><Z>8</Z></Vector3>
			<Coordinate3 name="CFrame">
				<X>0</X>
				<Y>0.4</Y>
				<Z>-35</Z>
				<R00>1</R00><R01>0</R01><R02>0</R02>
				<R10>0</R10><R11>0</R11><R12>0</R12>
